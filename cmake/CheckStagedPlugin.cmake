# Checks the staged plugin folder after the build.
#
# cmake -DPLUGIN_DIR=<folder> -DDLL_DIR=<folder of the built DLL> -DPLUGIN_VERSION=<YYYY.MM.PATCH> -P CheckStagedPlugin.cmake
#
# The folder holds exactly genonline_eos.dll, EOSSDK-Win32-Shipping.dll and plugin.manifest. The manifest lists exactly the
# two DLLs with their size and SHA-256, and the built DLL lies in that folder and in no per configuration subfolder.

cmake_minimum_required(VERSION 3.19)

foreach(required PLUGIN_DIR DLL_DIR PLUGIN_VERSION)
    if (NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()

set(failures "")

get_filename_component(stageDir "${PLUGIN_DIR}" REALPATH)
get_filename_component(dllDir "${DLL_DIR}" REALPATH)
if (NOT stageDir STREQUAL dllDir)
    list(APPEND failures "the DLL is built in ${dllDir}, not in the staged folder ${stageDir}")
endif()

set(expectedFiles EOSSDK-Win32-Shipping.dll genonline_eos.dll plugin.manifest)
file(GLOB_RECURSE actualFiles LIST_DIRECTORIES true RELATIVE "${stageDir}" "${stageDir}/*")
list(SORT actualFiles)
if (NOT actualFiles STREQUAL expectedFiles)
    list(APPEND failures "the folder holds [${actualFiles}] instead of [${expectedFiles}]")
endif()

if (EXISTS "${stageDir}/plugin.manifest")
    file(READ "${stageDir}/plugin.manifest" manifest)
    string(JSON format ERROR_VARIABLE error GET "${manifest}" format)
    if (error)
        list(APPEND failures "plugin.manifest is not valid JSON: ${error}")
    else()
        string(JSON name GET "${manifest}" name)
        string(JSON version GET "${manifest}" version)
        string(JSON apiVersion GET "${manifest}" api_version)
        string(JSON fileCount LENGTH "${manifest}" files)
        if (NOT format STREQUAL "1")
            list(APPEND failures "format is ${format}, not 1")
        endif()
        if (NOT name STREQUAL "genonline_eos")
            list(APPEND failures "name is ${name}, not genonline_eos")
        endif()
        if (NOT version STREQUAL PLUGIN_VERSION)
            list(APPEND failures "version is ${version}, not ${PLUGIN_VERSION}")
        endif()
        if (NOT apiVersion STREQUAL "1")
            list(APPEND failures "api_version is ${apiVersion}, not 1")
        endif()

        set(listedPaths "")
        if (fileCount GREATER 0)
            math(EXPR last "${fileCount} - 1")
            foreach(index RANGE ${last})
                string(JSON path GET "${manifest}" files ${index} path)
                string(JSON hash GET "${manifest}" files ${index} sha256)
                string(JSON size GET "${manifest}" files ${index} size)
                list(APPEND listedPaths "${path}")
                if (NOT EXISTS "${stageDir}/${path}")
                    list(APPEND failures "${path} is listed but missing")
                    continue()
                endif()
                file(SHA256 "${stageDir}/${path}" actualHash)
                file(SIZE "${stageDir}/${path}" actualSize)
                if (NOT hash STREQUAL actualHash)
                    list(APPEND failures "${path} has SHA-256 ${actualHash}, the manifest says ${hash}")
                endif()
                if (NOT size STREQUAL actualSize)
                    list(APPEND failures "${path} has ${actualSize} bytes, the manifest says ${size}")
                endif()
            endforeach()
        endif()
        list(SORT listedPaths)
        set(expectedListed EOSSDK-Win32-Shipping.dll genonline_eos.dll)
        if (NOT listedPaths STREQUAL expectedListed)
            list(APPEND failures "the manifest lists [${listedPaths}] instead of [${expectedListed}]")
        endif()
    endif()
else()
    list(APPEND failures "plugin.manifest is missing")
endif()

if (failures)
    list(JOIN failures "\n  " text)
    message(FATAL_ERROR "The staged plugin folder ${stageDir} is wrong:\n  ${text}")
endif()
message(STATUS "The staged plugin folder ${stageDir} is complete")
