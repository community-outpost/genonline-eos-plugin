{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win32-msvc",
      "displayName": "Windows x86, MSVC",
      "inherits": "windows",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      }
    },
    {
      "name": "win32-clang",
      "displayName": "Windows x86, clang-cl",
      "inherits": "windows",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "toolset": {
        "value": "ClangCL",
        "strategy": "set"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win32-msvc",
      "configurePreset": "win32-msvc",
      "configuration": "Release"
    },
    {
      "name": "win32-clang",
      "configurePreset": "win32-clang",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "win32-msvc",
      "configurePreset": "win32-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win32-clang",
      "configurePreset": "win32-clang",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
